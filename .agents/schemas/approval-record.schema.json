{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDLC Approval Record",
  "type": "object",

  "required": [
    "schema_version",
    "project_id",
    "cycle_id",
    "gate",
    "stage",
    "decision",
    "decision_scope",
    "decided_by",
    "decided_at"
  ],

  "properties": {
    "schema_version": {
      "type": "string"
    },

    "project_id": {
      "type": "string"
    },

    "cycle_id": {
      "type": "string",
      "description": "Cycle identifier, e.g. INIT-001 or CR-0001"
    },

    "change_id": {
      "type": ["string", "null"],
      "description": "Change Request identifier if applicable, or null for initial cycle"
    },

    "gate": {
      "enum": ["G0", "G1", "G2", "G3", "G4", "G5"]
    },

    "stage": {
      "enum": [
        "DEFINE",
        "SPEC",
        "DESIGN",
        "BUILD",
        "VERIFY",
        "RELEASE"
      ]
    },

    "decision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "APPROVED_WITH_COMMENTS",
        "REJECTED"
      ]
    },

    "decision_scope": {
      "type": "object"
    },

    "decided_by": {
      "type": "string"
    },

    "decided_at": {
      "type": "string"
    }
  }
}
